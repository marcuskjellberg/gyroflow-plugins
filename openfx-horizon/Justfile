TargetDir := env_var_or_default("CARGO_TARGET_DIR", "../target")

# Local development build (macOS): native arch only, ad-hoc signed
[macos]
dev:
    #!/bin/bash
    set -e

    cargo build --release --target-dir "{{TargetDir}}"

    cd "{{TargetDir}}"
    rm -rf gyroflow-ofx-horizon-dev/HorizonLeveling.ofx.bundle
    mkdir -p gyroflow-ofx-horizon-dev/HorizonLeveling.ofx.bundle/Contents/MacOS
    cp release/libgyroflow_ofx_horizon.dylib gyroflow-ofx-horizon-dev/HorizonLeveling.ofx.bundle/Contents/MacOS/HorizonLeveling.ofx
    cp "{{justfile_directory()}}/res/Info.plist" gyroflow-ofx-horizon-dev/HorizonLeveling.ofx.bundle/Contents/

    codesign -f -s - --deep gyroflow-ofx-horizon-dev/HorizonLeveling.ofx.bundle
    echo ""
    echo "Dev bundle ready: {{TargetDir}}/gyroflow-ofx-horizon-dev/HorizonLeveling.ofx.bundle"
    echo "Quit Resolve, then install with (does not touch the other Gyroflow bundles; removing the old bundle first"
    echo "matters: macOS kills a process that loads a signed binary overwritten in place):"
    echo "  sudo rm -rf /Library/OFX/Plugins/HorizonLeveling.ofx.bundle && sudo cp -R {{TargetDir}}/gyroflow-ofx-horizon-dev/HorizonLeveling.ofx.bundle /Library/OFX/Plugins/"
